# Template of the Worker variables and secrets (see .dev.vars.example for local use).
# Anything other than ENVIRONMENT=development|test is treated as production
# (HTTPS-only cookies, no localhost origins, masked errors).
ENVIRONMENT=development
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Secret salt for hashing client IPs (download dedupe, abuse reports).
HASH_SALT=change-me-to-a-long-random-string
# Exact origins allowed to call the API from a browser (never "*").
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Registry's own origin (used for same-origin CSRF checks).
PUBLIC_ORIGIN=http://localhost:8787
