{
  "name": "skillapt-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke.sh",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/db-seed.js",
    "db:seed:local": "wrangler d1 execute DB --local --file=./migrations/seed.sql"
  },
  "dependencies": {
    "hono": "4.13.17",
    "semver": "^7.8.6",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.5",
    "@types/semver": "^7.5.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.160.0"
  }
}
