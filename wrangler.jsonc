{
  // Skillapt registry: runs entirely on Cloudflare's free tier, on the free
  // *.workers.dev address (no custom domain required). See docs/DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillapt-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },

  // Non-secret configuration. `wrangler dev` reads .dev.vars, which overrides
  // these values locally (see .dev.vars.example).
  "vars": {
    // Anything other than "development" or "test" is treated as production.
    "ENVIRONMENT": "production",
    // The registry's own public URL, known after the first deploy, e.g.
    // "https://skillapt-registry.<your-subdomain>.workers.dev". Leave empty until then.
    "PUBLIC_ORIGIN": "",
    // Exact, comma-separated browser origins allowed to call the API
    // cross-origin, e.g. the Cloudflare Pages site: "https://skillapt-web.pages.dev".
    // "*" and localhost are rejected in production. Leave empty to allow none.
    "CORS_ORIGIN": ""
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skillapt-db",
      // PLACEHOLDER: replace with the id printed by `npx wrangler d1 create skillapt-db`.
      // Not needed for local development (`wrangler dev` uses a local database).
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "skillapt-packages"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER_DO",
        "class_name": "RateLimiterDO"
      }
    ]
  },
  // SQLite-backed Durable Objects are the only kind available on the free plan.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiterDO"]
    }
  ],
  // Daily cleanup of expired sessions, tokens and download-dedupe rows.
  "triggers": {
    "crons": ["0 0 * * *"]
  }

  // Optional, only if you later own a domain on Cloudflare:
  // "routes": [{ "pattern": "registry.example.com", "custom_domain": true }]
}
